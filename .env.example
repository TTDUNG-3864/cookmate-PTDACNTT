# APPLICATION
APP_ENV=development
PORT=5000
COOKMATE_SECRET_KEY=replace-with-a-long-random-secret

# MYSQL DATABASE
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cookmate
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=5

# GEMINI CLOUD AI (Priority #1 & #2 Free Tier Models — server only)
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_SECONDARY_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=28
GEMINI_MAX_RETRIES=1

# LOCAL AI FALLBACK (Priority #3 — called only when both Gemini models fail)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=90
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=520
OLLAMA_AUTO_START=true
OLLAMA_AUTO_PULL=false
CHATBOT_HISTORY_TURNS=4

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# CHATBOT
CHATBOT_ENABLED=true
CHATBOT_DOMAIN_GUARD=true
CHATBOT_RAG_ENABLED=true
